<section>
  <div class="container" style="max-width:820px">
    {%- if cart.item_count == 0 -%}
      <div class="center">
        <h1 class="h2" style="margin-bottom:18px">Your cart is empty.</h1>
        <p class="lead" style="margin:0 auto 30px">Everyday essentials are one click away.</p>
        <a class="btn solid" href="{{ routes.all_products_collection_url }}">Shop now →</a>
      </div>
    {%- else -%}
      <div class="sec-head">
        <div class="eyebrow">Cart</div>
        <h1 class="h2">Your cart.</h1>
      </div>
      <form action="{{ routes.cart_url }}" method="post" data-cart-form>
        {%- for item in cart.items -%}
          <div class="cartline">
            <div class="cimg">
              {%- if item.image -%}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.product.title }}{%- endif -%}
            </div>
            <div>
              <h4><a href="{{ item.url }}">{{ item.product.title }}</a></h4>
              <div class="cv">{% unless item.product.has_only_default_variant %}{{ item.variant.title }} · {% endunless %}{% render 'price', amount: item.final_price %} each</div>
              <div class="qtyrow" style="margin:10px 0 0">
                <button type="button" data-cart-qty="-1" aria-label="Decrease">−</button>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity" data-qty-input>
                <button type="button" data-cart-qty="1" aria-label="Increase">+</button>
              </div>
            </div>
            <div style="text-align:right">
              <div style="font-weight:700">{% render 'price', amount: item.final_line_price %}</div>
              <a class="cart-remove" href="{{ item.url_to_remove }}">Remove</a>
            </div>
          </div>
        {%- endfor -%}
        <div class="totalrow"><span>Total</span><span>{% render 'price', amount: cart.total_price %}</span></div>
        {%- if section.settings.note != blank -%}<p class="small-muted" style="margin-bottom:24px">{{ section.settings.note }}</p>{%- endif -%}
        <button class="btn solid block" type="submit" name="checkout">Proceed to checkout →</button>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "text", "id": "note", "label": "Note under total", "default": "Shipping is calculated at checkout." }
  ]
}
{% endschema %}
