<section class="strip">
  <div class="container">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h2" style="max-width:16em">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="lead strip-text">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.accent_text != blank -%}<p class="lead strip-accent">{{ section.settings.accent_text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn-light" href="{{ section.settings.button_link | default: '/collections' }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Dark strip",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "accent_text", "label": "Accent line" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Dark strip" }]
}
{% endschema %}
