<div class="hero">
  <div class="container">
    <div class="hero-head">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow" style="justify-content:center">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h1 class="hero-tag">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="lead" style="margin:0 auto 28px">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn solid" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.image != blank -%}
      <div class="hero-banner">
        {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '640,960,1240,1600,2000,2400', sizes: '(max-width: 1240px) 100vw, 1240px', loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt }}
      </div>
    {%- elsif section.settings.image_url != blank -%}
      <div class="hero-banner">
        <img src="{{ section.settings.image_url }}" alt="{{ section.settings.image_alt | escape }}" fetchpriority="high" width="2400" height="1200">
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "VYAM Store" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everyday products. Better ideas." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now →" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Banner image (2:1)", "info": "Upload the banner here so Shopify hosts it." },
    { "type": "text", "id": "image_url", "label": "Banner image URL (used only if no image is uploaded)" },
    { "type": "text", "id": "image_alt", "label": "Banner alt text" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
